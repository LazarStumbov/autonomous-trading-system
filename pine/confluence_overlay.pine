// © Lazar Stumbov / Stage 2 trading bot — MIT licensed
//
// Confluence Overlay — draws on the chart everything our screener needs to
// see at a glance: EMA stack (20/50/200), RSI extremes flagged, BB squeeze
// flag, ATR-based stop suggestion, support/resistance levels detected from
// pivot highs/lows, and a per-bar confluence score that the bot reads via
// `data_get_pine_tables` from `tradingview_bridge.read_pine_levels()`.
//
// Built for Pine v5. Lightweight — designed to be human-readable on the chart
// and bot-readable via the MCP.

//@version=5
indicator("ConfluenceOverlay", overlay=true, max_lines_count=20, max_labels_count=20, max_boxes_count=10)

// ---------- Inputs ----------
ema_fast_len   = input.int(20,  "EMA fast",  minval=1)
ema_mid_len    = input.int(50,  "EMA mid",   minval=1)
ema_slow_len   = input.int(200, "EMA slow",  minval=1)
rsi_len        = input.int(14,  "RSI length",minval=2)
rsi_overbought = input.int(70,  "RSI overbought")
rsi_oversold   = input.int(30,  "RSI oversold")
bb_len         = input.int(20,  "BB length", minval=2)
bb_mult        = input.float(2.0, "BB mult", minval=0.5)
kc_mult        = input.float(1.5, "KC mult", minval=0.5)
atr_len        = input.int(14,  "ATR length",minval=2)
atr_stop_mult  = input.float(1.5, "ATR stop mult", minval=0.5)
pivot_left     = input.int(5,   "Pivot left bars",  minval=1)
pivot_right    = input.int(5,   "Pivot right bars", minval=1)

// ---------- Indicators ----------
ema20  = ta.ema(close, ema_fast_len)
ema50  = ta.ema(close, ema_mid_len)
ema200 = ta.ema(close, ema_slow_len)

rsi    = ta.rsi(close, rsi_len)
atr    = ta.atr(atr_len)

bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_up    = bb_basis + bb_dev
bb_lo    = bb_basis - bb_dev

kc_basis = ta.sma(close, bb_len)
kc_range = kc_mult * atr
kc_up    = kc_basis + kc_range
kc_lo    = kc_basis - kc_range

// Squeeze: BB inside KC
squeeze = bb_up < kc_up and bb_lo > kc_lo

// ---------- Plots ----------
plot(ema20,  title="EMA 20",  color=color.new(color.aqua, 0))
plot(ema50,  title="EMA 50",  color=color.new(color.orange, 0))
plot(ema200, title="EMA 200", color=color.new(color.fuchsia, 0))

// EMA stack flag
ema_stack_bull = ema20 > ema50 and ema50 > ema200
ema_stack_bear = ema20 < ema50 and ema50 < ema200

bgcolor(squeeze ? color.new(color.yellow, 90) : na, title="Squeeze bg")

// ATR-based stop suggestion line (visible to bot via data_get_pine_lines)
atr_stop_long  = close - atr * atr_stop_mult
atr_stop_short = close + atr * atr_stop_mult

var line stop_line = na
if barstate.islast
    line.delete(stop_line)
    sl = ema_stack_bull ? atr_stop_long : atr_stop_short
    stop_line := line.new(bar_index - 1, sl, bar_index, sl, color=color.red, style=line.style_dashed, width=1)

// ---------- Pivot S/R levels ----------
ph = ta.pivothigh(high, pivot_left, pivot_right)
pl = ta.pivotlow(low,   pivot_left, pivot_right)

if not na(ph)
    line.new(bar_index[pivot_right], ph, bar_index, ph, color=color.new(color.red, 50), extend=extend.right, width=1)
    label.new(bar_index, ph, "R " + str.tostring(ph, format.mintick), style=label.style_label_left, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)
if not na(pl)
    line.new(bar_index[pivot_right], pl, bar_index, pl, color=color.new(color.green, 50), extend=extend.right, width=1)
    label.new(bar_index, pl, "S " + str.tostring(pl, format.mintick), style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

// ---------- Confluence score (0..100) ----------
score = 0
if ema_stack_bull
    score := score + 25
if ema_stack_bear
    score := score + 25
if rsi >= rsi_overbought or rsi <= rsi_oversold
    score := score + 15
if squeeze
    score := score + 20
if math.abs(close - ema50) <= atr  // pullback to mid EMA
    score := score + 20
if volume > ta.sma(volume, 20) * 1.5
    score := score + 20

// Clamp 0..100
score := math.min(100, score)

// ---------- Score table (read by data_get_pine_tables) ----------
var table tbl = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "Confluence",  bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, str.tostring(score) + "/100", bgcolor=color.new(color.black, 30), text_color=score >= 70 ? color.lime : score >= 50 ? color.yellow : color.red, text_size=size.small)
    table.cell(tbl, 0, 1, "EMA Stack",   bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, ema_stack_bull ? "BULL" : ema_stack_bear ? "BEAR" : "MIXED", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2, "RSI",         bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(rsi, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "Squeeze",     bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, squeeze ? "ON" : "OFF", text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 4, "ATR stop",    bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(atr_stop_long, format.mintick) + " / " + str.tostring(atr_stop_short, format.mintick), text_color=color.white, text_size=size.small)

// ---------- Alerts ----------
alertcondition(score >= 70 and ema_stack_bull,  title="Confluence LONG  (≥70)", message="Confluence LONG  on {{ticker}} at {{close}}")
alertcondition(score >= 70 and ema_stack_bear,  title="Confluence SHORT (≥70)", message="Confluence SHORT on {{ticker}} at {{close}}")
