# === NEWS ===
NEWSAPI_KEY=                          # https://newsapi.org/ (optional, extra news source)

# === POLYMARKET ===
POLYMARKET_API_KEY=                   # Polymarket API key
POLYMARKET_PRIVATE_KEY=               # Wallet private key for CLOB orders
POLYMARKET_PROXY_ADDRESS=             # Proxy contract address

# === AI ===
ANTHROPIC_API_KEY=                    # https://console.anthropic.com/

# === TRADINGVIEW ===
