# === NOTIFICATIONS ===
TELEGRAM_BOT_TOKEN=                   # Create via @BotFather on Telegram
TELEGRAM_CHAT_ID=                     # Your chat ID for receiving alerts
SLACK_WEBHOOK_URL=                    # Slack incoming webhook URL (optional)
NOTIFICATION_EMAIL=                   # Email for critical alerts (optional)

# === INFRASTRUCTURE ===
